# ==============================================================================
# PayTrace Backend Environment Variables Template
# Copy this file to .env for local development: cp .env.example .env
# NEVER commit .env to GitHub.
# ==============================================================================

# Server Port (Render sets this dynamically, defaults to 10000)
PORT=10000

# TiDB Cloud MySQL Connection
DB_URL=jdbc:mysql://gateway01.ap-southeast-1.prod.aws.tidbcloud.com:4000/paytrace_db?useSSL=true&sslMode=VERIFY_IDENTITY&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=your_tidb_username_here
DB_PASSWORD=your_tidb_password_here

# JWT Secret (Must be at least 256-bit hexadecimal or Base64 string in production)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B59703ipscmp8XB7WqMR.root

# CORS Allowed Origins (Comma-separated list)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://*.onrender.com

